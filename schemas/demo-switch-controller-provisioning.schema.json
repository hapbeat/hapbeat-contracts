{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapbeat.com/schemas/demo-switch-controller-provisioning.schema.json",
  "title": "Hapbeat Demo Switch controller USB provisioning frame",
  "oneOf": [{ "$ref": "#/$defs/getConfig" }, { "$ref": "#/$defs/setConfig" }, { "$ref": "#/$defs/factoryReset" }, { "$ref": "#/$defs/reboot" }, { "$ref": "#/$defs/configResponse" }, { "$ref": "#/$defs/statusResponse" }, { "$ref": "#/$defs/errorResponse" }],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "nullableIdentifier": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
    "requestId": { "$ref": "#/$defs/identifier" },
    "nullableRequestId": { "oneOf": [{ "$ref": "#/$defs/requestId" }, { "type": "null" }] },
    "ipv4": { "type": "string", "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$", "not": { "pattern": "^(?:0|127|22[4-9]|23[0-9]|24[0-9]|25[0-5])\\." } },
    "nullableIpv4": { "oneOf": [{ "$ref": "#/$defs/ipv4" }, { "type": "null" }] },
    "secret": { "type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256, "description": "Input only. MUST NOT appear in responses, logs, fixtures, telemetry, or diagnostics." },
    "wifiSsid": { "type": "string", "minLength": 1, "maxLength": 32, "x-maxUtf8Bytes": 32 },
    "wifiProfile": { "type": "object", "required": ["ssid", "open", "wifi_password_set"], "additionalProperties": false, "properties": { "ssid": { "$ref": "#/$defs/wifiSsid" }, "open": { "type": "boolean" }, "wifi_password_set": { "type": "boolean" } }, "allOf": [{ "if": { "properties": { "open": { "const": true } } }, "then": { "properties": { "wifi_password_set": { "const": false } } }, "else": { "properties": { "wifi_password_set": { "const": true } } } }] },
    "wifiProfileUpdate": { "type": "object", "required": ["ssid"], "additionalProperties": false, "properties": { "ssid": { "$ref": "#/$defs/wifiSsid" }, "wifi_password": { "$ref": "#/$defs/secret" }, "open": { "type": "boolean" } }, "allOf": [{ "not": { "required": ["wifi_password", "open"], "properties": { "open": { "const": true } } } }] },
    "config": { "type": "object", "required": ["wifi_profiles", "hmd_ip", "controller_id", "target_a_demo_id", "target_b_demo_id", "target_c_demo_id", "shared_secret_set", "allow_unsigned", "isolated_lan", "next_sequence"], "additionalProperties": false, "properties": { "wifi_profiles": { "type": "array", "maxItems": 5, "uniqueItems": true, "x-uniqueBy": "ssid", "description": "SSID values MUST be unique; x-uniqueBy is required because JSON Schema uniqueItems cannot enforce property uniqueness.", "items": { "$ref": "#/$defs/wifiProfile" } }, "hmd_ip": { "$ref": "#/$defs/nullableIpv4" }, "controller_id": { "$ref": "#/$defs/identifier" }, "target_a_demo_id": { "$ref": "#/$defs/nullableIdentifier" }, "target_b_demo_id": { "$ref": "#/$defs/nullableIdentifier" }, "target_c_demo_id": { "$ref": "#/$defs/nullableIdentifier" }, "shared_secret_set": { "type": "boolean" }, "allow_unsigned": { "type": "boolean" }, "isolated_lan": { "type": "boolean" }, "next_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } },
    "configUpdate": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "wifi_profiles": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "x-uniqueBy": "ssid", "description": "SSID values MUST be unique; x-uniqueBy is required because JSON Schema uniqueItems cannot enforce property uniqueness.", "items": { "$ref": "#/$defs/wifiProfileUpdate" } }, "clear_wifi_profiles": { "type": "boolean" }, "hmd_ip": { "$ref": "#/$defs/ipv4" }, "controller_id": { "$ref": "#/$defs/identifier" }, "target_a_demo_id": { "$ref": "#/$defs/identifier" }, "target_b_demo_id": { "$ref": "#/$defs/identifier" }, "target_c_demo_id": { "$ref": "#/$defs/identifier" }, "shared_secret": { "$ref": "#/$defs/secret" }, "clear_hmd_ip": { "type": "boolean" }, "clear_controller_id": { "type": "boolean" }, "clear_target_a_demo_id": { "type": "boolean" }, "clear_target_b_demo_id": { "type": "boolean" }, "clear_target_c_demo_id": { "type": "boolean" }, "clear_shared_secret": { "type": "boolean" }, "allow_unsigned": { "type": "boolean" }, "isolated_lan": { "type": "boolean" } }, "allOf": [{ "not": { "required": ["wifi_profiles", "clear_wifi_profiles"], "properties": { "clear_wifi_profiles": { "const": true } } } }, { "if": { "properties": { "allow_unsigned": { "const": true } }, "required": ["allow_unsigned"] }, "then": { "required": ["isolated_lan"], "properties": { "isolated_lan": { "const": true } } } }, { "not": { "required": ["allow_unsigned", "shared_secret"], "properties": { "allow_unsigned": { "const": true } } } }] },
    "getConfig": { "type": "object", "required": ["version", "type", "id"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "get_config" }, "id": { "$ref": "#/$defs/requestId" } } },
    "setConfig": { "type": "object", "required": ["version", "type", "id", "config"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "set_config" }, "id": { "$ref": "#/$defs/requestId" }, "config": { "$ref": "#/$defs/configUpdate" } } },
    "factoryReset": { "type": "object", "required": ["version", "type", "id"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "factory_reset" }, "id": { "$ref": "#/$defs/requestId" } } },
    "reboot": { "type": "object", "required": ["version", "type", "id"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "reboot" }, "id": { "$ref": "#/$defs/requestId" } } },
    "configResponse": { "type": "object", "required": ["version", "type", "id", "response", "config"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "response" }, "id": { "$ref": "#/$defs/requestId" }, "response": { "const": "config" }, "config": { "$ref": "#/$defs/config" } } },
    "status": { "oneOf": [{ "type": "object", "required": ["command", "state"], "additionalProperties": false, "properties": { "command": { "const": "set_config" }, "state": { "const": "updated" } } }, { "type": "object", "required": ["command", "state"], "additionalProperties": false, "properties": { "command": { "const": "factory_reset" }, "state": { "const": "reset" } } }, { "type": "object", "required": ["command", "state"], "additionalProperties": false, "properties": { "command": { "const": "reboot" }, "state": { "const": "rebooting" } } }] },
    "statusResponse": { "type": "object", "required": ["version", "type", "id", "response", "status"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "response" }, "id": { "$ref": "#/$defs/requestId" }, "response": { "const": "status" }, "status": { "$ref": "#/$defs/status" } } },
    "error": { "type": "object", "required": ["code", "message"], "additionalProperties": false, "properties": { "code": { "enum": ["invalid_json", "line_too_long", "unsupported_version", "unknown_command", "invalid_request", "invalid_config", "conflicting_update", "write_failed", "busy"] }, "message": { "type": "string", "maxLength": 256, "x-maxUtf8Bytes": 256 } } },
    "errorResponse": { "type": "object", "required": ["version", "type", "id", "response", "error"], "additionalProperties": false, "properties": { "version": { "const": 1 }, "type": { "const": "response" }, "id": { "$ref": "#/$defs/nullableRequestId" }, "response": { "const": "error" }, "error": { "$ref": "#/$defs/error" } } }
  }
}
