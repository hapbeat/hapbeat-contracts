{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapbeat.com/schemas/demo-session-descriptor.schema.json",
  "title": "Hapbeat Demo Session descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "demo_id", "title", "options", "supports"],
  "properties": {
    "version": { "const": 1 },
    "demo_id": { "$ref": "#/$defs/identifier" },
    "title": { "$ref": "#/$defs/label" },
    "minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["haptics_toggle"],
      "properties": { "haptics_toggle": { "type": "boolean" } }
    },
    "options": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "value": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$" },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja"],
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 40 },
        "en": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "values", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": { "value": { "$ref": "#/$defs/value" }, "label": { "$ref": "#/$defs/label" } }
          }
        },
        "default": { "$ref": "#/$defs/value" },
        "when": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } }
        }
      }
    }
  }
}
