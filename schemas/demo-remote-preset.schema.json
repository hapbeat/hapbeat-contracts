{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapbeat.com/schemas/demo-remote-preset.schema.json",
  "title": "Hapbeat Demo Remote preset transfer",
  "description": "Plans built on the web showcase and imported into the Android Demo Remote as presets (demo-session.md). The UTF-8 encoding must not exceed 700 bytes and duplicate keys are invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "presets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
          },
          "description": "1-40 code points, at least one non-space character, no C0/C1 control characters or line/paragraph separators."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "description": "Same rules as a step of the Hub start extra (steps).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demo_id"
      ],
      "properties": {
        "demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "options": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
          }
        },
        "retry": {
          "type": "boolean"
        }
      }
    }
  }
}
