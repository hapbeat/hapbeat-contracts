{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapbeat.com/schemas/demo-switch-message.schema.json",
  "title": "Hapbeat Demo Switch message",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/discover"
    },
    {
      "$ref": "#/$defs/here"
    },
    {
      "$ref": "#/$defs/query"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/preset_get"
    },
    {
      "$ref": "#/$defs/preset"
    },
    {
      "$ref": "#/$defs/preset_set"
    },
    {
      "$ref": "#/$defs/preset_start"
    }
  ],
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "seq",
        "demo_id",
        "action",
        "scene_id"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "CONTROL"
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "enum": [
            "menu_open",
            "menu_close",
            "recenter",
            "restart",
            "scene",
            "haptics_on",
            "haptics_off",
            "haptics_ui_show",
            "haptics_ui_hide",
            "recenter_ui_show",
            "recenter_ui_hide",
            "tutorial_start"
          ]
        },
        "scene_id": {
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "scene"
          }
        }
      },
      "then": {
        "properties": {
          "scene_id": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "else": {
        "properties": {
          "scene_id": {
            "const": ""
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "auth": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "base": {
      "type": "object",
      "required": [
        "version",
        "type",
        "controller_id",
        "seq",
        "demo_id"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "command": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "SWITCH"
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "current_demo_id",
            "code",
            "message"
          ],
          "properties": {
            "type": {
              "enum": [
                "ACK",
                "READY",
                "FAILED"
              ]
            },
            "current_demo_id": {
              "$ref": "#/$defs/identifier"
            },
            "code": {
              "enum": [
                "ok",
                "invalid_payload",
                "unsupported_version",
                "invalid_auth",
                "unsigned_disabled",
                "not_allowed",
                "replay",
                "launch_failed",
                "listener_failed"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 256,
              "x-maxUtf8Bytes": 256,
              "description": "Diagnostic message. Implementations MUST enforce the 256-byte limit after UTF-8 encoding; maxLength alone cannot express this constraint."
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "discover": {
      "type": "object",
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "DISCOVER"
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "here": {
      "type": "object",
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce",
        "current_demo_id"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "HERE"
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "current_demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "QUERY"
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce",
        "current_demo_id",
        "foreground",
        "haptics_on",
        "haptics_ui",
        "recenter_ui",
        "paused",
        "step_index",
        "step_count"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "STATE"
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "current_demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "foreground": {
          "type": "boolean",
          "description": "false while not the focused foreground app; SWITCH / CONTROL are then refused"
        },
        "haptics_on": {
          "type": "boolean"
        },
        "haptics_ui": {
          "type": "boolean"
        },
        "recenter_ui": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "step_index": {
          "type": "integer",
          "minimum": -1,
          "maximum": 32,
          "description": "0-based Demo Session step; -1 outside a session"
        },
        "step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "description": "0 outside a session"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "preset_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "preset_name": {
      "description": "Empty (no name) or 1-40 code points, at least one non-space character, no C0/C1 control characters or line/paragraph separators (demo-remote-preset name rules).",
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
          }
        }
      ]
    },
    "preset_step": {
      "description": "Same rules as a step of the Hub start extra (steps).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demo_id"
      ],
      "properties": {
        "demo_id": {
          "$ref": "#/$defs/identifier"
        },
        "options": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
          }
        },
        "retry": {
          "type": "boolean"
        }
      }
    },
    "preset_get": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce",
        "preset",
        "from"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "type": {
          "const": "PRESET_GET"
        },
        "preset": {
          "$ref": "#/$defs/preset_number"
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "nonce",
        "preset",
        "revision",
        "name",
        "visible",
        "step_count",
        "from",
        "steps"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "type": {
          "const": "PRESET"
        },
        "preset": {
          "$ref": "#/$defs/preset_number"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Increases whenever the Hub saves the preset"
        },
        "name": {
          "$ref": "#/$defs/preset_name"
        },
        "visible": {
          "type": "boolean"
        },
        "step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/preset_step"
          },
          "description": "Steps from `from` that fit in 1024 bytes; empty when from >= step_count or the step at `from` alone does not fit"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "preset_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "seq",
        "demo_id",
        "preset",
        "name",
        "visible",
        "steps"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "demo_id": {
          "const": "demo_hub"
        },
        "type": {
          "const": "PRESET_SET"
        },
        "preset": {
          "$ref": "#/$defs/preset_number"
        },
        "name": {
          "$ref": "#/$defs/preset_name"
        },
        "visible": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/preset_step"
          }
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "preset_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "controller_id",
        "seq",
        "demo_id",
        "preset"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "controller_id": {
          "$ref": "#/$defs/identifier"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "demo_id": {
          "const": "demo_hub"
        },
        "type": {
          "const": "PRESET_START"
        },
        "preset": {
          "$ref": "#/$defs/preset_number"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    }
  }
}
