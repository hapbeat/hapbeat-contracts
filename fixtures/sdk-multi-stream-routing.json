{
  "devices": [
    {
      "id": "left",
      "ip": "192.0.2.10",
      "port": 7700,
      "address": "player_1/pos_l_arm/group_1"
    },
    {
      "id": "right",
      "ip": "192.0.2.11",
      "port": 7700,
      "address": "player_1/pos_r_arm/group_1"
    }
  ],
  "sources": [
    {
      "id": "left_only",
      "target": "player_1/pos_l_arm",
      "expected_endpoint_ids": ["left"],
      "expected_status": "Active"
    },
    {
      "id": "both",
      "target": "player_1/*",
      "expected_endpoint_ids": ["left", "right"],
      "expected_status": "Active"
    },
    {
      "id": "missing",
      "target": "player_2/*",
      "expected_endpoint_ids": [],
      "expected_status": "Deferred",
      "expected_deferred_reason": "NoResolvedEndpoint"
    }
  ],
  "expected_sessions": [
    {
      "endpoint_id": "left",
      "source_ids": ["left_only", "both"],
      "stream_begin_target": "player_1/pos_l_arm/group_1"
    },
    {
      "endpoint_id": "right",
      "source_ids": ["both"],
      "stream_begin_target": "player_1/pos_r_arm/group_1"
    }
  ],
  "address_override_cases": [
    {
      "source_id": "left_only",
      "from_target": "player_1/pos_l_arm",
      "to_target": "player_1/pos_r_arm",
      "old_endpoint_id": "left",
      "known_new_endpoint_id": "right",
      "expected_old_endpoint_streaming": false,
      "expected_new_endpoint_streaming": true,
      "forbidden": ["broadcast_stream_packet", "replay_playback"]
    },
    {
      "source_id": "left_only",
      "from_target": "player_1/pos_l_arm",
      "to_target": "player_2/pos_l_arm",
      "old_endpoint_id": "left",
      "known_new_endpoint_id": null,
      "expected_status_before_pong": "Deferred",
      "expected_immediate_discovery": "PING",
      "pong_endpoint": {
        "id": "player_2_left",
        "ip": "192.0.2.12",
        "port": 7700,
        "address": "player_2/pos_l_arm/group_1"
      },
      "expected_status_after_pong": "Active",
      "expected_new_endpoint_streaming": true,
      "forbidden": ["broadcast_stream_packet", "replay_playback"]
    }
  ],
  "forbidden": [
    "broadcast_stream_packet",
    "cross_route_end_then_begin"
  ]
}
